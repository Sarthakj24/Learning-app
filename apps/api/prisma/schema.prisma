  status               tenant_status          @default(trial)
  is_platform          Boolean                @default(false)
  branding             Json                   @default("{}")
  settings             Json                   @default("{}")
  plan_id              String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  acknowledgments      acknowledgments[]
  assessments          assessments[]
  assignment_rules     assignment_rules[]
  assignments          assignments[]
  attempts             attempts[]
  audit_logs           audit_logs[]
  categories           categories[]
  certificates         certificates[]
  courses              courses[]
  departments          departments[]
  enrollments          enrollments[]
  lessons              lessons[]
  locations            locations[]
  module_versions      module_versions[]
  modules              modules[]
  notifications        notifications[]
  practical_checklists practical_checklists[]
  practical_signoffs   practical_signoffs[]
  questions            questions[]
  roles                roles[]
  skills               skills[]
  subscriptions        subscriptions[]
  tags                 tags[]
  plans                plans?                 @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_roles           user_roles[]
  user_skills          user_skills[]
  users                users[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_roles {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String       @db.Uuid
  user_id       String       @db.Uuid
  role_id       String       @db.Uuid
  location_id   String?      @db.Uuid
  department_id String?      @db.Uuid
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  departments   departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations     locations?   @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles         roles        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants       tenants      @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_user_roles_tenant")
  @@index([user_id], map: "idx_user_roles_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_skills {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String            @db.Uuid
  user_id                String            @db.Uuid
  skill_id               String            @db.Uuid
  level                  proficiency_level
  earned_from_version_id String?           @db.Uuid
  earned_at              DateTime          @default(now()) @db.Timestamptz(6)
  expires_at             DateTime?         @db.Timestamptz(6)
  module_versions        module_versions?  @relation(fields: [earned_from_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skills                 skills            @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants                tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                  users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, skill_id])
  @@index([tenant_id], map: "idx_user_skills_tenant")
  @@index([user_id], map: "idx_user_skills_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                                                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                                              String               @db.Uuid
  email                                                  String?         @db.Citext
  phone                                                  String?
  password_hash                                          String?
  full_name                                              String
  status                                                 user_status          @default(invited)
  language                                               String               @default("en")
  default_location_id                                    String?              @db.Uuid
  department_id                                          String?              @db.Uuid
  last_login_at                                          DateTime?            @db.Timestamptz(6)
  created_at                                             DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime             @default(now()) @db.Timestamptz(6)
  acknowledgments                                        acknowledgments[]
  assignments                                            assignments[]
  attempts                                               attempts[]
  audit_logs                                             audit_logs[]
  certificates                                           certificates[]
  courses                                                courses[]
  enrollments                                            enrollments[]
  module_versions                                        module_versions[]
  modules_modules_approved_byTousers                     modules[]            @relation("modules_approved_byTousers")
  modules_modules_created_byTousers                      modules[]            @relation("modules_created_byTousers")
  notifications                                          notifications[]
  practical_signoffs_practical_signoffs_signed_byTousers practical_signoffs[] @relation("practical_signoffs_signed_byTousers")
  practical_signoffs_practical_signoffs_user_idTousers   practical_signoffs[] @relation("practical_signoffs_user_idTousers")
  user_roles                                             user_roles[]
  user_skills                                            user_skills[]
  locations                                              locations?           @relation(fields: [default_location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments                                            departments?         @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                                                tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, email])
  @@index([tenant_id], map: "idx_users_tenant")
}

