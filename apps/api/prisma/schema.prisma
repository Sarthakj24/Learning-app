/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String             @db.Uuid
  assessment_id    String             @db.Uuid
  type             question_type      @default(single)
  prompt           String
  media_url        String?
  explanation      String?
  difficulty       Int                @default(2)
  is_active        Boolean            @default(true)
  ai_generated     Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  question_options question_options[]
  assessments      assessments        @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants          tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assessment_id], map: "idx_questions_assessment")
  @@index([tenant_id], map: "idx_questions_tenant")
}

model role_permissions {
  role_id        String      @db.Uuid
  permission_key String
  permissions    permissions @relation(fields: [permission_key], references: [key], onDelete: Cascade, onUpdate: NoAction)
  roles          roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_key])
}

model role_skill_requirements {
  role_id        String            @db.Uuid
  skill_id       String            @db.Uuid
  required_level proficiency_level @default(capable)
  roles          roles             @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skills         skills            @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, skill_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model roles {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String                    @db.Uuid
  name                    String
  base_role               system_role               @default(user)
  is_template             Boolean                   @default(false)
  description             String?
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  role_permissions        role_permissions[]
  role_skill_requirements role_skill_requirements[]
  tenants                 tenants                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_roles              user_roles[]

  @@unique([tenant_id, name])
  @@index([tenant_id], map: "idx_roles_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model skills {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String                    @db.Uuid
  name                    String
  description             String?
  category_id             String?                   @db.Uuid
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  module_skills           module_skills[]
  practical_checklists    practical_checklists[]
  role_skill_requirements role_skill_requirements[]
  categories              categories?               @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants                 tenants                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_skills             user_skills[]

  @@unique([tenant_id, name])
  @@index([tenant_id], map: "idx_skills_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subscriptions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  plan_id      String    @db.Uuid
  status       String    @default("active")
  seats        Int       @default(0)
  period_start DateTime? @db.Date
  period_end   DateTime? @db.Date
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  plans        plans     @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants      tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_subscriptions_tenant")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tags {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
