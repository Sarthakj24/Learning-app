{
  "name": "whnow-learn-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:migrate": "npm run migrate:safe && node dist/seed.js && node dist/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:safe": "prisma migrate deploy || (prisma migrate resolve --rolled-back 0001_init && prisma migrate deploy)",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": { "seed": "tsx src/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "prisma": "^6.19.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
